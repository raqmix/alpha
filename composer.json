{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "afsakar/filament-otp-login": "^2.0",
        "amidesfahani/filament-tinyeditor": "^5.0",
        "astrotomic/laravel-translatable": "^11.17",
        "awcodes/filament-curator": "^5.1",
        "bepsvpt/secure-headers": "^7.5",
        "bezhansalleh/filament-shield": "^4.3",
        "filament/filament": "^5.0",
        "guava/filament-icon-picker": "^4.0",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.11",
        "laravel/tinker": "^2.8",
        "outerweb/settings": "^1.1",
        "owen-it/laravel-auditing": "^14.0",
        "owenvoke/blade-fontawesome": "^2.6",
        "pepperfm/filament-json": "5.0.2",
        "propaganistas/laravel-phone": "^5.3",
        "ralphjsmit/laravel-filament-seo": "^2.2",
        "ralphjsmit/laravel-seo": "^1.6",
        "solution-forest/filament-tree": "^4.0",
        "spatie/laravel-sitemap": "*",
        "spatie/laravel-translation-loader": "^2.8",
        "stevebauman/location": "^7.5",
        "stijnvanouplines/blade-country-flags": "^1.0.9",
        "tapp/filament-auditing": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13",
        "fakerphp/faker": "^1.9.1",
        "filament/upgrade": "^5.0",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "CactusGalaxy\\FilamentAstrotomic\\": "packages/filament-astrotomic/src/",
            "Outerweb\\FilamentSettings\\": "packages/filament-settings/src/",
            "Kenepa\\TranslationManager\\": "packages/translation-manager/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
